# ssh/.ssh/config (tracked, public)

Include ~/.ssh/config.local

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github

Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/id_ed25519_codeberg

Host jasmin
    HostName login2.jasmin.ac.uk
    IdentityFile ~/.ssh/id_rsa_jasmin

Host *
    ServerAliveInterval 60
    IdentitiesOnly yes
    AddKeysToAgent yes
